{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mavuus-client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5180", "--strictPort"],
      "port": 5180,
      "autoPort": false,
      "cwd": "mavuus-app/client"
    },
    {
      "name": "mavuus-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "cwd": "mavuus-app/server"
    },
    {
      "name": "storybook",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "storybook", "--", "--no-open"],
      "port": 6006,
      "autoPort": false,
      "cwd": "mavuus-app/client"
    }
  ]
}
